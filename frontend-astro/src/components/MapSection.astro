---
// Импорт компонента заголовка секции 
import SectionHeader from './SectionHeader.astro'
// Импорт API функции для получения данных карты из CMS (Strapi)
import { getMapSection } from '../api/map'

// Асинхронная загрузка данных для секции карты
const data = await getMapSection()
---

{/* Условный рендеринг секции карты*/}
{data && (
  <section class="map-section">
    <SectionHeader title={data.title} subtitle={data.subtitle} />
     {/* КОНТЕЙНЕР ДЛЯ КАРТЫ*/}
    <div class="map-section__wrapper">
      {/* ВСТРАИВАЕМАЯ КАРТА*/}
      <iframe
        class="map-section__iframe"
        src={data.embedUrl}
        width="1180"
        height="500"
        loading="lazy"
        allowfullscreen
        title="Карта расположения"
      ></iframe>
    </div>
  </section>
)}

<style lang="scss">
.map-section {
  &__wrapper {
    overflow: hidden;
    border-radius: 32px;
  }

  &__iframe {
    display: block;
    width: 100%;
    height: 500px;
    border: none;
    border-radius: 32px;
  }
}

@media (max-width: 768px) {
  .map-section {
    &__wrapper {
      border-radius: 18px;
    }

    &__iframe {
      height: 350px;
      border-radius: 18px;
    }
  }
}
</style>

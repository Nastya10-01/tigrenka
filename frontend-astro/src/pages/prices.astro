---
// Импорт основного layout-компонента (общая структура с шапкой, подвалом и метатегами)
import Layout from '../layouts/Layout.astro'

// Импорт секционных компонентов для построения страницы цен
import AppBanner from '../components/AppBanner.astro'
import PricingSection from '../components/PricingSection.astro'
import ContactFormSection from '../components/ContactFormSection.astro'
import MapSection from '../components/MapSection.astro'

// API функции для работы с данными из Strapi (CMS)
import { getPricesPage } from '../api/prices'
import { getPricingCards } from '../api/collections'
import { strapiMedia } from '../api/strapi'

// Параллельная загрузка данных для оптимизации производительности
const [pageData, pricingCards] = await Promise.all([
  getPricesPage(), // Данные о странице: заголовок баннера, вступительные тексты, изображения
  getPricingCards(), // Массив карточек с ценами: название услуги, стоимость, описание, иконка
])
---

<!--Передаём в Layout метаданные для SEO-->
<Layout
  title="Цены — Игровой центр Тигра в Аше"
  description="Стоимость посещения игрового центра Тигра в Аше. Билеты на аттракционы, XBOX, праздники и дни рождения. Доступные цены для всей семьи."
>

  <!--Основной контейнер страницы-->
  <div class="page container">
    <!--Условный рендеринг баннера: Показываем баннер если данные успешно загружены из CMS-->
    {pageData && (
      <Fragment>
        <!--Баннер страницы цен-->
        <AppBanner
          title={pageData.bannerTitle}
          image={strapiMedia(pageData.bannerImage)}
        />
        <!--Блок с вступительным текстом о ценах-->
        <div class="prices__text">
          <p>{pageData.introText1}</p>
          <p>{pageData.introText2}</p>
        </div>
        <!--Секция с карточками цен (тарифы, услуги, развлечения)-->
        <PricingSection
          cards={pricingCards}
          image1={strapiMedia(pageData.pricingImage1)}
          image2={strapiMedia(pageData.pricingImage2)}
        />
      </Fragment>
    )}
      <!--Форма обратной связи-->
      <ContactFormSection />
    <!--Карта с местоположением-->
    <MapSection />
  </div>
</Layout>

<style lang="scss">

  /*Стили для блока вступительного текста о ценах*/
.prices__text {
  background-color: var(--color-primary);
  color: #fff;
  border-radius: 45px;
  padding: 50px;
  font-size: 24px;
  font-weight: 500;
  line-height: 1.6;

  /* 
    Стиль для соседних параграфов */
  p + p {
    margin-top: 8px;
  }
}

@media (max-width: 768px) {
  .prices__text {
    padding: 24px;
    font-size: 16px;
    border-radius: 20px;
  }
}
</style>
